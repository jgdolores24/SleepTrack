<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F3F9"
    tools:context=".Patrones">

    <ScrollView
        android:id="@+id/scrollPatrones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/txtTituloPatrones"
                android:text="Patrones de sueño"
                android:textColor="#2E2342"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:id="@+id/txtSubtituloPatrones"
                android:text="Conoce mejor tus hábitos de descanso."
                android:textColor="#9183A1"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/estadoCargando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="450dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <ProgressBar
                    android:id="@+id/progresoCargaPatrones"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#7053B0" />

                <TextView
                    android:id="@+id/txtEstadoCargaPatrones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="Cargando tus registros..."
                    android:textColor="#81728F"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnReintentarPatrones"
                    android:layout_width="160dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/st_pt_boton"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Reintentar"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/estadoSinRegistros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="450dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:layout_width="192dp"
                    android:layout_height="192dp"
                    android:background="@drawable/st_pt_halo_exterior">

                    <FrameLayout
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        android:background="@drawable/st_pt_halo_interior">

                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:layout_gravity="center"
                            android:contentDescription="Patrones de sueño"
                            android:src="@drawable/st_pt_moon" />

                    </FrameLayout>

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="Tu primera noche abre el camino"
                    android:textColor="#332545"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMensajeVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="290dp"
                    android:text="Tu primer descanso registrado aparecerá aquí."
                    android:textColor="#92859E"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnIrRegistros"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/st_pt_boton"
                    android:gravity="center"
                    android:text="Comienza tu primera noche"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Solo mostramos información registrada"
                    android:textColor="#A397AF"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenidoConRegistros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/st_pt_selector"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <TextView
                        android:id="@+id/btn7Dias"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/st_pt_periodo_activo"
                        android:gravity="center"
                        android:text="7 días"
                        android:textColor="#7053B0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn30Dias"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="30 días"
                        android:textColor="#9185A0"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn90Dias"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="90 días"
                        android:textColor="#9185A0"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/st_pt_resumen"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:paddingBottom="34dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TU DESCANSO EN ESTE PERÍODO"
                        android:textColor="#E7DFF5"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtPromedioDuracion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#FFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Promedio de descanso"
                                android:textColor="#D7CDEA"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtNumeroNoches"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="sesiones"
                                android:textColor="#D7CDEA"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtIndicadorResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Calculando indicadores..."
                        android:textColor="#E5D8F7"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/st_pt_card"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tus horas, noche a noche"
                        android:textColor="#2F2644"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtResumenPeriodo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Cargando registros..."
                        android:textColor="#8A7B99"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:id="@+id/contenedorGraficoPatrones"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/txtEstadoGraficoPatrones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Solo se representan evaluaciones guardadas"
                        android:textColor="#8C7F98"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Lo que observamos"
                    android:textColor="#2D2440"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Tus registros y consejos generales de descanso"
                    android:textColor="#91849E"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/contenedorPatrones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="SleepTrack muestra estimaciones y coincidencias, no diagnósticos."
                    android:textColor="#A296AA"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/barraNavegacion"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/st_capsula_fondo"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/navAlarma"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/st_capsula_alarma"
                android:contentDescription="Alarma"
                android:tint="#C5BFCF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Alarma"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/navRegistros"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/st_capsula_registros"
                android:contentDescription="Registros"
                android:tint="#C5BFCF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Registros"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/st_capsula_seleccionado">

                <ImageButton
                    android:id="@+id/navPatrones"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:src="@drawable/st_capsula_patrones"
                    android:contentDescription="Patrones"
                    android:tint="#211A2D" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Patrones"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/navConsejos"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/st_capsula_consejos"
                android:contentDescription="Consejos"
                android:tint="#C5BFCF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Consejos"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/navPerfil"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/st_capsula_perfil"
                android:contentDescription="Perfil"
                android:tint="#C5BFCF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Perfil"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
