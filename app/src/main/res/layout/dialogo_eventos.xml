<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_dialogo_actividad"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtTituloDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suplementos"
        android:textColor="#292035"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Consulta tus registros y sus horarios."
        android:textColor="#80738D"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/scrollListaEventos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contenedorListaEventos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/btnAgregarEvento"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="#7053B0"
        android:text="+ Agregar registro"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnCerrarDialogo"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="CERRAR"
        android:textColor="#7053B0"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
