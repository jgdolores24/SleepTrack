<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <ScrollView
        android:id="@+id/scrollDescanso"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/contenedorFinalizar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/cabeceraDescanso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/st_sesion_panel_oscuro"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PRÓXIMA ALARMA"
                        android:textColor="#8B8B91"
                        android:textSize="10sp"
                        android:letterSpacing="0.06"/>
                    <TextView
                        android:id="@+id/txtProximaAlarma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="07:00"
                        android:textColor="#F2F2F4"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <Space android:layout_width="10dp" android:layout_height="1dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:background="@drawable/st_sesion_panel_oscuro"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ESTADO"
                        android:textColor="#8B8B91"
                        android:textSize="10sp"
                        android:letterSpacing="0.06" />
                    <TextView
                        android:id="@+id/txtMonitoreos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="En descanso"
                        android:textColor="#F2F2F4"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtCabeceraDescanso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Tu descanso"
                    android:textColor="#ADADB1"
                    android:textSize="14sp"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/txtHoraActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-thin"
                    android:text="23:15"
                    android:textColor="#FFFFFF"
                    android:textSize="76sp" />

                <TextView
                    android:id="@+id/txtRestante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:text="7 h 45 min restantes"
                    android:textColor="#909095"
                    android:textSize="17sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtAvisoPantalla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="La pantalla se atenuará automáticamente"
                android:textColor="#66666C"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/contenedorFinalizar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Comenzó a las"
            android:textColor="#818187"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/txtInicioDescanso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="23:15"
            android:textColor="#B0B0B7"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/btnFinalizarDescanso"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:background="@drawable/st_sesion_boton_detener"
            android:text="■"
            android:textColor="#F5F5F6"
            android:textSize="30sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mantén pulsado para finalizar descanso" />
        <TextView
            android:id="@+id/txtMantener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Mantén pulsado 3 segundos para finalizar"
            android:textColor="#8F8F96"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
