<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9FF"
    tools:context=".CrearCuenta">

    <View
        android:layout_width="142dp"
        android:layout_height="142dp"
        android:translationX="42dp"
        android:translationY="-64dp"
        android:background="@drawable/fondo_halo_crear_sleeptrack"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="43dp"
            android:paddingEnd="26dp"
            android:paddingBottom="28dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="43dp">

                <TextView
                    android:id="@+id/txtTituloCrear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Crea tu cuenta"
                    android:textColor="#282039"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnAtrasRegistro"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageButton
                    android:id="@+id/btnAtrasRegistro"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/fondo_circulo_crear_sleeptrack"
                    android:contentDescription="Volver a iniciar sesión"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_volver_sleeptrack"
                    android:focusable="true"
                    android:clickable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Un lugar para entender mejor tus noches."
                android:textColor="#877E9A"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="Correo electrónico"
                android:textColor="#877E9A"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fondo_campo_crear_sleeptrack"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="13dp"
                    android:contentDescription="Icono de correo"
                    android:src="@drawable/ic_correo_sleeptrack" />

                <EditText
                    android:id="@+id/etCorreoRegistro"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:autofillHints="emailAddress"
                    android:hint="tucorreo@ejemplo.com"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:gravity="center_vertical"
                    android:textColor="#282039"
                    android:textColorHint="#877E9A"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="Contraseña"
                android:textColor="#877E9A"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fondo_campo_crear_sleeptrack"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="13dp"
                    android:contentDescription="Icono de candado"
                    android:src="@drawable/ic_candado_sleeptrack" />

                <EditText
                    android:id="@+id/etContrasenaRegistro"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:autofillHints="newPassword"
                    android:hint="Mínimo 6 caracteres"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:gravity="center_vertical"
                    android:textColor="#282039"
                    android:textColorHint="#877E9A"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="Confirmar contraseña"
                android:textColor="#877E9A"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fondo_campo_crear_sleeptrack"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="13dp"
                    android:contentDescription="Icono de candado"
                    android:src="@drawable/ic_candado_sleeptrack" />

                <EditText
                    android:id="@+id/etConfirmarContrasena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:autofillHints="newPassword"
                    android:hint="Repite tu contraseña"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:gravity="center_vertical"
                    android:textColor="#282039"
                    android:textColorHint="#877E9A"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="37dp"
                android:background="@drawable/fondo_privacidad_crear_sleeptrack"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="Icono de privacidad"
                    android:src="@drawable/ic_privacidad_sleeptrack" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:layout_marginEnd="12dp"
                    android:text="Tus datos son privados y están protegidos."
                    android:textColor="#3C285B"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarCuenta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="37dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Crear mi cuenta"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#7053B0"
                app:cornerRadius="16dp" />

            <TextView
                android:id="@+id/btnVolverInicio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="13dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="¿Ya tienes cuenta?    Inicia sesión"
                android:textColor="#7053B0"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
