<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F3F9">

    <LinearLayout
        android:id="@+id/encabezadoConsejos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Consejos"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#2E2342" />

            <TextView
                android:id="@+id/btnRecordatorios"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="◷  Mis recordatorios"
                android:textSize="12sp"
                android:textColor="#7053B0"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/st_co_chip" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/st_co_avatar">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/st_capsula_consejos"
                    android:tint="#C9B3EF"
                    android:contentDescription="Asistente de sueño"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tu asistente de sueño"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#30264A"/>
                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Pregúntame sobre tu descanso"
                    android:textColor="#84738F"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAjustesIA"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⋯"
                android:textColor="#7053B0"
                android:textSize="24sp"
                android:contentDescription="Opciones del asistente"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollMensajes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/encabezadoConsejos"
        app:layout_constraintBottom_toTopOf="@id/barraEscrituraConsejos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contenedorConversacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="20dp" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/barraEscrituraConsejos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/st_co_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etPreguntaConsejos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Pregunta lo que quieras..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="43dp"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:textColor="#30264A"
            android:textColorHint="#9E91AC"
            android:textSize="13sp"
            android:maxLength="1000" />

        <ImageButton
            android:id="@+id/btnEnviarConsejos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/st_co_send"
            android:src="@drawable/ic_enviar_consejos"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Enviar mensaje"
            android:clickable="true"
            android:focusable="true"
            android:tint="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/barraNavegacion"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/st_capsula_fondo"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/navAlarma"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/st_capsula_alarma"
                android:contentDescription="Alarma"
                android:tint="#C5BFCF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Alarma"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/navRegistros"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/st_capsula_registros"
                android:contentDescription="Registros"
                android:tint="#C5BFCF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Registros"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/navPatrones"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/st_capsula_patrones"
                android:contentDescription="Patrones"
                android:tint="#C5BFCF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Patrones"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/st_capsula_seleccionado">

                <ImageButton
                    android:id="@+id/navConsejos"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:src="@drawable/st_capsula_consejos"
                    android:contentDescription="Consejos"
                    android:tint="#211A2D" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Consejos"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/navPerfil"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/st_capsula_perfil"
                android:contentDescription="Perfil"
                android:tint="#C5BFCF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="Perfil"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
